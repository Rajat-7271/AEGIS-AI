{
  "git": {
    "deploymentEnabled": {
      "fix/trivy-dependency-remediation": false,
      "codex/windows-staging-readiness": false,
      "codex/isolated-staging-api": false
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache" }
      ]
    }
  ]
}
